Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Image
    Name: Raw Image
    Enabled: true
    Value: true
    Topic:
      Value: /top_camera_view/input_image
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  - Class: rviz_default_plugins/Image
    Name: Annotated Image
    Enabled: true
    Value: true
    Topic:
      Value: /top_camera_view/annotated_image
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  Global Options:
    Fixed Frame: top_color_optical_frame
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
Window Geometry:
  Width: 1400
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
